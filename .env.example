# --- SMTP transport (Zoho Mail) -------------------------------------------
# Use the host for the data centre your Zoho account was created in — the
# wrong region fails authentication even with correct credentials:
#   smtp.zoho.com      US        smtp.zoho.eu        Europe
#   smtp.zoho.in       India     smtp.zoho.com.au    Australia
#   smtp.zoho.jp       Japan     smtp.zohocloud.ca   Canada
#   smtp.zoho.sa       Saudi Arabia
SMTP_HOST=smtp.zoho.com

# 465 = SSL (recommended), 587 = STARTTLS. SMTP_SECURE is inferred from the
# port, so you only need to set it if you are overriding that.
SMTP_PORT=465
# SMTP_SECURE=true

# Your full Zoho address, not just the local part.
SMTP_USER=you@yourdomain.com
# With two-factor auth on (and Zoho pushes you to enable it), a normal account
# password is rejected. Generate an app-specific password instead:
#   Zoho Accounts -> Security -> App Passwords -> Generate New Password
SMTP_PASS=your-app-specific-password

# --- Sender identity ------------------------------------------------------
MAIL_FROM_NAME=Your Name
# Must be the authenticated mailbox above, or an alias/"send mail as" address
# already verified in Zoho. Anything else is rejected with a relaying error.
# Defaults to SMTP_USER when omitted.
MAIL_FROM_EMAIL=you@yourdomain.com
# Optional: where replies should land.
# MAIL_REPLY_TO=replies@yourdomain.com
