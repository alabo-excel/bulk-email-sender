# Copy keys from your Clerk application's API keys page.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# SMTP credentials are entered in onboarding and saved encrypted in the browser.
# No SMTP environment variables are needed.

# Server-side key used to encrypt SMTP passwords before the browser stores them.
# Generate with:  openssl rand -base64 32
# Never prefix this with VITE_ — Vite inlines VITE_* vars into the client bundle,
# which would publish the key. Rotating it makes every saved sender unreadable,
# and users will be asked to enter their password again.
VAULT_KEY=replace-me-with-openssl-rand-base64-32
